<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Conversations | DocuRAG</title>
  </head>
  <body>
    <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem">
      <h1>Conversations</h1>
      <div>
        <a href="/">Dashboard</a>
        |
        <a href="/chat">Chat</a>
      </div>
    </header>

    <% if (!locals.conversations || locals.conversations.length === 0) { %>
      <p>No conversations yet.</p>
    <% } else { %>
      <ul>
        <% locals.conversations.forEach(function(conversation) { %>
          <li>
            <a href="/chat?conversationId=<%= conversation._id %>"><%= conversation.title %></a>
            <span> — <%= new Date(conversation.updatedAt).toLocaleString() %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </body>
</html>
